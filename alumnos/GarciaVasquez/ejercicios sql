		p.fecha,
		pr.nombre 	As total
		d.cantidad *d.precio_unit as total
		from detalle_pedido d
		join pedido p on d.id_pedido  =p.id_pedido
		join cliente c on p.id_cliente  =c.id_cliente
		

		

