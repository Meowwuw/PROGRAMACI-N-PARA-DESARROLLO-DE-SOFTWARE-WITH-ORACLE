--      Muestra correo_original y correo_limpio.
--
--      Después responde:
--      ¿TRIM modifica el dato guardado en la tabla?
--      RESPUESTA:No. TRIM() no modifica el dato guardado en la tabla. Solo elimina temporalmente los espacios al inicio y al final en el resultado de la consulta. Para modificar el dato se necesitaría un UPDATE.
SELECT
    correo AS correo_original,
    TRIM(correo) AS correo_limpio
FROM persona
WHERE correo <> TRIM(correo);


